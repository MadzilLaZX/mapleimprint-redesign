# Staging Postgres — the "maple-imprint-catalogue" Supabase project (ca-central-1, free tier,
# id ovqkwedpwmuusnijbxro). RLS is enabled with no anon/authenticated policies, so this
# connection must use the service-role/direct-connection credentials, not the anon key.
# Get the password from the Supabase dashboard for that project: Project Settings > Database >
# Connection string (the MCP integration used to create this project cannot read it back out).
# Never commit a real value here or in .env — see README's security note. Real supplier
# credentials belong in a secrets manager, never in this file.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ovqkwedpwmuusnijbxro.supabase.co:5432/postgres"

# S&S Activewear Canada — real connector, see src/integrations/suppliers/ssactivewear/README.md.
# Get these from: log in -> My Account -> Manage Web Users -> Manage Permissions -> enable
# "Integrations (API/Promostandards)" -> My Account -> API Key -> Show.
SSACTIVEWEAR_ACCOUNT_NUMBER="[YOUR-ACCOUNT-NUMBER]"
SSACTIVEWEAR_API_KEY="[YOUR-API-KEY]"
