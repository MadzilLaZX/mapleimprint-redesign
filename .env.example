# Copy to .env.local for local dev, and set the same values in the Vercel
# project's Environment Variables settings for production. See AUTOMATION.md
# for how to obtain each value. All of these are server-only — none are
# exposed to the browser.

# Resend (transactional email) — resend.com
RESEND_API_KEY=
# Must be on a domain verified in Resend (Resend > Domains).
RESEND_FROM_EMAIL=quotes@mapleimprint.ca

# Where new-lead notification emails are sent.
OWNER_NOTIFICATION_EMAIL=info@mapleimprint.ca

# Google service account (shared by Sheets lead log + Drive file uploads)
# — console.cloud.google.com. See AUTOMATION.md for full setup steps.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the downloaded JSON key file, keeping the
# \n sequences literal (don't turn them into real line breaks).
GOOGLE_PRIVATE_KEY=
# The long ID in your Google Sheet's URL: .../spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# The ID in your Drive folder's URL: drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=

# Telegram owner notifications — message @BotFather to create a bot
TELEGRAM_BOT_TOKEN=
# Chat ID to send lead alerts to (a DM with the bot, or a group it's in)
TELEGRAM_CHAT_ID=

# Photoroom Remove Background API — photoroom.com/api, used by Studio's "Remove Background"
# button on uploaded images. ~$0.02/image, no charge for repeated clicks on the same source image
# (see src/app/api/studio/remove-background/route.ts's duplicate-cost-prevention check). Without
# this set, the button shows a friendly "not available yet" message rather than erroring.
PHOTOROOM_API_KEY=

# Square (checkout & payments) — developer.squareup.com/apps > your app > Credentials/Locations.
# "sandbox" or "production" — also read client-side (Web Payments SDK script URL), hence
# NEXT_PUBLIC_. Not a secret; keep this and the two NEXT_PUBLIC_ values below in sync with the
# server-only ones when switching environments.
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Server-only — never expose. Credentials tab (Sandbox Access Token) / production equivalent.
SQUARE_ACCESS_TOKEN=
# Webhooks tab > your subscription's Signature Key. Only needed once a webhook subscription
# exists (requires a public HTTPS notification URL, e.g. a Vercel preview/production deployment).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must byte-for-byte match the Notification URL configured on that subscription.
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Chit Chats (planned primary shipping carrier) — chitchats.com > Settings > Developer > API
# Access Tokens. NOT YET SET ANYWHERE — no account exists for this business yet; see
# docs/chit-chats-staging-validation.md for the procedure to run once it does. "staging" points at
# https://staging.chitchats.com for testing; the docs don't state whether staging needs its own
# separate token/client ID or reuses production's — confirm that first (validation doc step 1)
# before assuming either.
CHIT_CHATS_ENVIRONMENT=staging
# Server-only — never expose. Exact Authorization header format (bearer prefix vs. raw token) is
# not stated in Chit Chats' docs; see src/lib/server/chitChatsClient.ts's own note.
CHIT_CHATS_API_ACCESS_TOKEN=
# Every API path is scoped under /clients/<THIS>/ — found in the same Settings > Developer page.
CHIT_CHATS_CLIENT_ID=
# Only needed to run scripts/chit-chats-staging-check.mjs — an address YOU choose and approve for
# test shipments (the script refuses to run without all of these set; it has no built-in default).
CHIT_CHATS_TEST_RECIPIENT_NAME=
CHIT_CHATS_TEST_ADDRESS_1=
CHIT_CHATS_TEST_CITY=
CHIT_CHATS_TEST_PROVINCE=
CHIT_CHATS_TEST_POSTAL_CODE=
CHIT_CHATS_TEST_COUNTRY=CA

# n8n webhook URL that receives a payload per paid order (reference, contact info, and each line's
# productName/quantity/designSnapshot) for production handoff — building each item's Asset file
# (logos/PNGs referenced in the design) and Design file (the layout spec) and filing them in Drive.
# Fired best-effort from src/lib/checkout/fulfillOrder.ts; unset = step is silently skipped.
N8N_ORDER_CONFIRMATION_WEBHOOK_URL=

# Supabase service-role key for the maple-imprint-catalogue project — Project Settings > API >
# service_role secret key. Bypasses Row Level Security entirely; used only by
# src/lib/server/supabaseAdmin.ts for order/payment tables. Treat as a top-tier secret — never
# log it, never send it to the client, never paste it anywhere other than this file.
SUPABASE_SERVICE_ROLE_KEY=

# Staff admin section (/admin) — one shared password, no per-staff accounts (src/lib/admin/session.ts).
# Pick a long random value; this is what staff type in at /admin/login.
ADMIN_PASSWORD=
# Separate random secret used only to sign the staff session cookie (HMAC) — rotating this logs
# everyone out without changing the actual staff password above.
ADMIN_SESSION_SECRET=
